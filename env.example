# This is an example file. When deploying, you will add these keys and your
# generated values to your hosting provider's "Config Vars" or "Secrets" section.
# DO NOT COMMIT YOUR ACTUAL SECRETS TO GIT.

# --- Database ---
# For local development with SQLite, you can uncomment the following line:
# DATABASE_URL="sqlite:///./sql_app.db"
# For production with PostgreSQL, `fly postgres attach` sets this automatically.

# --- Security ---
# A strong, random secret string for signing JWTs.
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY="YOUR_JWT_SECRET_KEY_HERE"

# A key for encrypting sensitive data like OAuth tokens.
# Generate one in a Python shell: from cryptography.fernet import Fernet; Fernet.generate_key().decode()
FERNET_KEY="YOUR_FERNET_KEY_HERE"

# A strong, random secret used to sign the OAuth state/nonce session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET_KEY="YOUR_SESSION_SECRET_KEY_HERE"

# --- OAuth Credentials ---
# Credentials from your GitHub OAuth App.
# Authorization callback URL must be set to: <this API's base URL>/auth/github/callback
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# Credentials from your Google Cloud Console OAuth 2.0 Client ID.
# Authorized redirect URI must be set to: <this API's base URL>/auth/google/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# --- Frontend ---
# Base URL of the deployed frontend (no trailing slash). After a successful
# OAuth login the browser is redirected to "<FRONTEND_URL>/app.html".
FRONTEND_URL="http://localhost:3000"

# --- AI Service ---
# Your API key from Google AI Studio (for Gemini)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Deployment Environment ---
# Set to "true" via `fly secrets set` for production security settings (like secure cookies)
PRODUCTION="false"

# The URL for your Redis instance (`fly redis create` provides this)
REDIS_URL="redis://localhost:6379/0"